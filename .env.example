# ==============================================================================
# DockFlow AI - Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://dockflow_user:dockflow_pass@localhost:5432/dockflow_db?schema=public"

# Ring Partner API & Webhook Credentials
# Official Ring API base endpoint: https://api.amazonvision.com
RING_API_BASE_URL="https://api.amazonvision.com"
# Ring Developer Playground or OAuth access token
RING_ACCESS_TOKEN="your_ring_playground_access_token_here"
# Shared secret for HMAC-SHA256 signature verification on incoming webhooks (header X-Signature)
RING_WEBHOOK_SECRET="your_ring_webhook_signing_secret_here"
# OAuth 2.0 Credentials (for full account linking)
RING_CLIENT_ID="your_ring_oauth_client_id"
RING_CLIENT_SECRET="your_ring_oauth_client_secret"
RING_REDIRECT_URI="http://localhost:3000/api/auth/ring/callback"

# Security & Session Authentication
JWT_SECRET="dockflow-super-secret-jwt-key-change-in-production-min-32-chars"
SESSION_EXPIRY_SECONDS=86400

# AWS & Cloud Storage Configuration (Bedrock & S3)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
S3_EVIDENCE_BUCKET="dockflow-receiving-evidence"
S3_ENDPOINT="" # Leave blank for AWS S3, or set to MinIO URL (e.g. http://localhost:9000)
BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"

# Application Settings
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="info"
